<Window x:Class="ShopSimpleWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="380" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Магазин" FontSize="26" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="Вход в систему" Margin="0,5,0,22"
                   Foreground="#6B7280" HorizontalAlignment="Center" />

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Логин" Margin="0,0,0,5" />
            <TextBox x:Name="LoginTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Пароль" Margin="0,0,0,5" />
            <PasswordBox x:Name="PasswordTextBox" Height="30" Padding="5,3" />
        </StackPanel>

        <Button Grid.Row="5" Content="Войти" Height="38"
                Click="LoginButton_Click" />
    </Grid>
</Window>
